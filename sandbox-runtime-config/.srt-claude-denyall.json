{
  "network": {
    "allowedDomains": [],
    "deniedDomains": [
      "gist.github.com",
      "*:25",
      "*:587",
      "*:465"
    ],
    "deniedDomainReasons": {
      "gist.github.com": "Creating gists is blocked by sandbox policy (exfiltration risk). Write to a file in the repo instead.",
      "*:25": "Direct SMTP is blocked by sandbox policy.",
      "*:587": "Direct SMTP is blocked by sandbox policy.",
      "*:465": "Direct SMTP is blocked by sandbox policy."
    },
    "allowAllDomains": true,
    "allowLocalBinding": true,
    "tlsTerminate": {},
    "requireHostMatch": true
  },
  "credentials": {
    "envVars": [
      {
        "name": "GH_TOKEN",
        "mode": "mask",
        "injectHosts": ["github.com", "*.github.com"]
      }
    ]
  },
  "filesystem": {
    "denyRead": [
      "/Users",
      "/Volumes",
      "/cores",
      "/opt/cisco",
      "/etc/openldap",
      "/etc/krb5.conf",
      "/private/var/log/jamf.log",
      "/private/var/folders",
      "/**/.env*",
      "/**/*.pem",
      "/**/*.key",
      "/**/id_rsa*",
      "/**/id_ed25519*",
      "/**/credentials.json",
      "/**/credentials",
      "/**/credentials.toml",
      "/**/secrets.yaml",
      "/**/secrets.yml"
    ],
    "allowRead": [
      ".",
      "~/src",
      "~/ltic",
      "~/.claude",
      "~/.claude.json",
      "~/.claude.json.lock",
      "~/.local",
      "~/bin",
      "~/.cache",
      "~/Library/Caches/claude-cli-nodejs",
      "~/.npm",
      "~/.npmrc",
      "~/.nvm",
      "~/.cargo",
      "~/.rustup",
      "~/.config/git",
      "~/.config/gh",
      "~/Library/Application Support/glab-cli",
      "~/.gitconfig",
      "~/.ssh/config",
      "~/.ssh/known_hosts",
      "~/Library/pnpm",
      "/**/.env.example",
      "/**/.env.sample",
      "/**/.env.template",
      "/**/.env.dist",
      "/**/id_*.pub",
      "/**/id_rsa*.pub",
      "/**/id_ed25519*.pub"
    ],
    "allowWrite": [
      ".",
      "/private/tmp",
      "~/.claude",
      "~/.cache",
      "~/.npm",
      "~/.claude.json.lock",
      "~/.local/state/claude",
      "~/.local/share/uv",
      "~/.cargo/registry",
      "~/.cargo/git",
      "~/.cargo/.package-cache",
      "~/Library/pnpm/store",
      "~/Library/Caches/claude-cli-nodejs"
    ],
    "denyWrite": [
      "~/.claude/settings.json",
      "~/.claude/settings.local.json",
      "~/.claude/CLAUDE.md",
      "~/.claude.json"
    ]
  },
  "ignoreViolations": {
    "*": [
      "sysctl-read kern.",
      "mach-lookup com.apple.SystemConfiguration.configd",
      ".GlobalPreferences",
      "Library/Preferences/ByHost",
      "mach-lookup com.apple.dnssd.service",
      "mach-lookup com.apple.usymptomsd",
      "/.zshenv",
      "/.aws/cli/cache/session.db",
      "/.claude.json.tmp.",
      "mach-lookup com.apple.FSEvents",
      "Library/Keychains/login.keychain-db",
      "Claude Code URL Handler.app",
      "/.zprofile"
    ]
  },
  "enableWeakerNetworkIsolation": true,
  "allowPty": true
}
