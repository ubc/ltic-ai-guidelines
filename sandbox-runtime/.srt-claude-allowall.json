{
  "network": {
    "allowedDomains": [],
    "deniedDomains": [
      "gist.github.com",
      "*:25",
      "*:587",
      "*:465"
    ],
    "deniedDomainReasons": {
      "gist.github.com": "Creating gists is blocked by sandbox policy (exfiltration risk). Write to a file in the repo instead.",
      "*:25": "Direct SMTP is blocked by sandbox policy.",
      "*:587": "Direct SMTP is blocked by sandbox policy.",
      "*:465": "Direct SMTP is blocked by sandbox policy."
    },
    "allowAllDomains": true,
    "allowLocalBinding": false,
    "tlsTerminate": {}
  },
  "credentials": {
    "envVars": [
      {
        "name": "GH_TOKEN",
        "mode": "mask",
        "injectHosts": ["github.com", "*.github.com"]
      }
    ]
  },
  "filesystem": {
    "allowRead": [
      "/**/.env.example",
      "/**/.env.sample",
      "/**/.env.template",
      "/**/.env.dist",
      "/**/id_*.pub",
      "/**/id_rsa*.pub",
      "/**/id_ed25519*.pub"
    ],
    "denyRead": [
      "~/.ssh-vault",
      "~/.aws-vault",
      "~/.kube-vault",
      "~/.gnupg",
      "~/.netrc",

      "~/.bash_history",
      "~/.zsh_history",
      "~/.viminfo",
      "~/.lesshst",
      "~/.python_history",

      "~/.aws",
      "~/.docker/config.json",
      "~/.saml2aws",
      "~/.npmrc",
      "~/.config/github-copilot",

      "~/Library/Keychains",
      "~/Library/Cookies",
      "~/Library/Application Support/Firefox",
      "~/Library/Application Support/Google/Chrome",
      "~/Library/Application Support/Slack",
      "~/Library/Application Support/Signal",
      "~/Library/Mail",
      "~/Library/Messages",
      "~/Library/Containers/com.apple.iChat",

      "/**/.env*",
      "/**/*.pem",
      "/**/*.key",
      "/**/id_rsa*",
      "/**/id_ed25519*",
      "/**/credentials.json",
      "/**/credentials",
      "/**/credentials.toml",
      "/**/secrets.yaml",
      "/**/secrets.yml",

      "~/.cisco",
      "~/.vpn",
      "~/OneDrive - UBC",
      "~/Documents",
      "~/Desktop",
      "~/Downloads",

      "/Volumes",
      "/cores",
      "/opt/cisco",
      "/private/var/folders",
      "/etc/openldap",
      "/etc/krb5.conf",
      "/private/var/log/jamf.log"
    ],
    "allowWrite": [
      ".",
      "/private/tmp",
      "~/.claude",
      "~/.cache",
      "~/.npm",
      "~/.claude.json",
      "~/.claude.json.lock",
      "~/.local/state/claude",
      "~/.local/share/uv",
      "~/.cargo/registry",
      "~/.cargo/git",
      "~/.cargo/.package-cache",
      "~/Library/pnpm/store"
    ],
    "denyWrite": [
      "~/.claude/settings.json",
      "~/.claude/settings.local.json",
      "~/.claude/CLAUDE.md"
    ]
  },
  "ignoreViolations": {
    "*": [
      "sysctl-read kern.",
      "mach-lookup com.apple.SystemConfiguration.configd",
      ".GlobalPreferences",
      "Library/Preferences/ByHost"
    ]
  },
  "enableWeakerNetworkIsolation": true,
  "allowPty": true
}
