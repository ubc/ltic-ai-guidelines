{
  "network": {
    "allowedDomains": [],
    "deniedDomains": [
      "gist.github.com",
      "*:25",
      "*:587",
      "*:465"
    ],
    "deniedDomainReasons": {
      "gist.github.com": "Creating gists is blocked by sandbox policy (exfiltration risk). Write to a file in the repo instead.",
      "*:25": "Direct SMTP is blocked by sandbox policy.",
      "*:587": "Direct SMTP is blocked by sandbox policy.",
      "*:465": "Direct SMTP is blocked by sandbox policy."
    },
    "allowAllDomains": true,
    "allowLocalBinding": true,
    "tlsTerminate": {}
  },
  "credentials": {
    "envVars": [
      {
        "name": "GH_TOKEN",
        "mode": "mask",
        "injectHosts": ["github.com", "*.github.com"]
      }
    ]
  },
  "filesystem": {
    "denyRead": [
      "/Users",
      "/Volumes",
      "/cores",
      "/opt/cisco",
      "/etc/openldap",
      "/etc/krb5.conf",
      "/private/var/log/jamf.log",
      "/private/var/folders"
    ],
    "allowRead": [
      ".",
      "~/src",
      "~/ltic",
      "~/.claude",
      "~/.claude.json",
      "~/.claude.json.lock",
      "~/.local",
      "~/bin",
      "~/.cache",
      "~/.npm",
      "~/.npmrc",
      "~/.nvm",
      "~/.cargo",
      "~/.rustup",
      "~/.config/git",
      "~/.config/gh",
      "~/Library/Application Support/glab-cli",
      "~/.gitconfig",
      "~/.ssh/config",
      "~/.ssh/known_hosts",
      "~/Library/pnpm"
    ],
    "denyReadAlways": [
      "/**/.env*",
      "/**/*.pem",
      "/**/*.key",
      "/**/id_rsa*",
      "/**/id_ed25519*",
      "/**/credentials.json",
      "/**/credentials",
      "/**/credentials.toml",
      "/**/secrets.yaml",
      "/**/secrets.yml"
    ],
    "allowWrite": [
      ".",
      "/private/tmp",
      "~/.claude",
      "~/.cache",
      "~/.npm",
      "~/.claude.json",
      "~/.claude.json.lock",
      "~/.local/state/claude",
      "~/.local/share/uv",
      "~/.cargo/registry",
      "~/.cargo/git",
      "~/.cargo/.package-cache",
      "~/Library/pnpm/store"
    ],
    "denyWrite": [
      "~/.claude/settings.json",
      "~/.claude/settings.local.json",
      "~/.claude/CLAUDE.md"
    ]
  },
  "ignoreViolations": {
    "*": [
      "sysctl-read kern.",
      "mach-lookup com.apple.SystemConfiguration.configd",
      ".GlobalPreferences",
      "Library/Preferences/ByHost"
    ]
  },
  "enableWeakerNetworkIsolation": true,
  "allowPty": true
}
